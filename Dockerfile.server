ARG DOCKER_REGISTRY=""
FROM ${DOCKER_REGISTRY}node:22-alpine AS web-build
WORKDIR /src/web
COPY web/package*.json ./
RUN --mount=type=cache,id=legado-npm-cache,target=/root/.npm \
    if [ -f package-lock.json ]; then \
        npm ci --ignore-scripts --no-audit --fund=false; \
    else \
        npm install --ignore-scripts --no-audit --fund=false; \
    fi
COPY web/ ./
RUN npm run build

FROM ${DOCKER_REGISTRY}gradle:8.13-jdk21 AS server-build
WORKDIR /src
COPY gradle/ gradle/
COPY gradle/libs.versions.toml gradle/libs.versions.toml
COPY server/ server/
COPY --from=web-build /src/web/dist/ server/src/main/resources/static/
RUN --mount=type=cache,target=/home/gradle/.gradle gradle -p server clean installDist --no-daemon --no-build-cache \
    && jar uf server/build/install/legado-server/lib/legado-server-0.1.0.jar -C server/src/main/resources static

FROM ${DOCKER_REGISTRY}eclipse-temurin:17-jre-jammy
RUN apt-get update && apt-get install -y --no-install-recommends gosu && rm -rf /var/lib/apt/lists/* \
    && groupadd --system legado && useradd --system --gid legado legado
WORKDIR /app
COPY --from=server-build /src/server/build/install/legado-server/ ./
COPY server/docker-entrypoint.sh /app/entrypoint.sh
RUN chmod 755 /app/entrypoint.sh
ENV LEGADO_DATA_DIR=/data LEGADO_PORT=8080 LEGADO_SECURE_COOKIES=false
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["/app/bin/legado-server"]
